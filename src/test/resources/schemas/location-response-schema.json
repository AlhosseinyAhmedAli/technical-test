{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Zippopotam.us location response",
  "type": "object",
  "required": ["post code", "country", "country abbreviation", "places"],
  "properties": {
    "post code": { "type": "string" },
    "country": { "type": "string" },
    "country abbreviation": { "type": "string" },
    "places": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["place name", "longitude", "latitude", "state", "state abbreviation"],
        "properties": {
          "place name": { "type": "string" },
          "longitude": { "type": "string" },
          "latitude": { "type": "string" },
          "state": { "type": "string" },
          "state abbreviation": { "type": "string" }
        }
      }
    }
  }
}
